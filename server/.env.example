# Copy to .env for local development. Never commit your real .env.
DATABASE_URL=postgresql://user:password@host:5432/zyrox
DATABASE_SSL=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# Public OAuth audience ID; never put a client secret in the app.
GOOGLE_WEB_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
NODE_ENV=development
PORT=3000
# Comma-separated additional web origins; native Capacitor origins are allowed by default.
ALLOWED_ORIGINS=https://your-web-app.example
# Set only to the number of trusted reverse proxies in front of the server.
TRUST_PROXY=1

# Password recovery requires SMTP. Keep all credentials in your hosting provider's secret manager.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=ZYROX <no-reply@example.com>
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
